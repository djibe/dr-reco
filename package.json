{
  "name": "dr-reco",
  "private": true,
  "version": "0.8.1",
  "description": "Assistant de diagnostic et maintenance informatique pour cabinets médicaux",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "generate:icons": "npm run tauri icon ./public/favicon.svg",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "npm run tauri build",
    "tauri:build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-win.ps1",
    "tauri:build:win:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-win.ps1 -DebugBuild -NoBundle",
    "tauri:update": "cd ./src-tauri && cargo update"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "tauri-plugin-hwinfo": "^0.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "author": "Jean-Baptiste FRON",
  "license": "CC-BY-NC-SA-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/djibe/dr-reco.git"
  },
  "bugs": {
    "url": "https://github.com/djibe/dr-reco/issues"
  }
}
